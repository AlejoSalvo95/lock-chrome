{
  "manifest_version": 3,
  "name": "Profile Lock",
  "version": "1.1.0",
  "description": "Bloquea la navegación web de este perfil de Chrome hasta ingresar una contraseña.",
  "permissions": [
    "declarativeNetRequest",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
